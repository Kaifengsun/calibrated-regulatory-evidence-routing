{
  "$defs": {
    "ConstructionCategory": {
      "enum": [
        "direct_clause",
        "parent_heading_context",
        "table_related",
        "citation_dependency",
        "evidence_insufficient"
      ],
      "title": "ConstructionCategory",
      "type": "string"
    },
    "Domain": {
      "enum": [
        "chemical",
        "pharmaceutical"
      ],
      "title": "Domain",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "authoring_source_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[^\\x00-\\x1f\\x7f]{1,128}$",
        "type": "string"
      },
      "maxItems": 20,
      "title": "Authoring Source Ids",
      "type": "array"
    },
    "construction_category": {
      "$ref": "#/$defs/ConstructionCategory"
    },
    "counter_cue_tags": {
      "items": {
        "type": "string"
      },
      "maxItems": 10,
      "title": "Counter Cue Tags",
      "type": "array"
    },
    "domain": {
      "$ref": "#/$defs/Domain"
    },
    "language": {
      "enum": [
        "zh",
        "en"
      ],
      "title": "Language",
      "type": "string"
    },
    "query_text": {
      "maxLength": 1000,
      "minLength": 3,
      "title": "Query Text",
      "type": "string"
    },
    "question_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[^\\x00-\\x1f\\x7f]{1,128}$",
      "title": "Question Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_group_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[^\\x00-\\x1f\\x7f]{1,128}$",
      "title": "Source Group Id",
      "type": "string"
    }
  },
  "required": [
    "question_id",
    "domain",
    "language",
    "query_text",
    "construction_category",
    "source_group_id"
  ],
  "title": "QueryRecord",
  "type": "object"
}
