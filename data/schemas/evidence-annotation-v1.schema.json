{
  "$defs": {
    "AnnotationRole": {
      "enum": [
        "primary",
        "duplicate",
        "adjudicated"
      ],
      "title": "AnnotationRole",
      "type": "string"
    },
    "EvidenceLabel": {
      "enum": [
        "REQUIRED",
        "SUFFICIENT",
        "CONTEXT",
        "IRRELEVANT",
        "HARMFUL"
      ],
      "title": "EvidenceLabel",
      "type": "string"
    },
    "PathId": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3",
        "P4",
        "P5"
      ],
      "title": "PathId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "annotated_at": {
      "format": "date-time",
      "title": "Annotated At",
      "type": "string"
    },
    "annotation_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[^\\x00-\\x1f\\x7f]{1,128}$",
      "title": "Annotation Id",
      "type": "string"
    },
    "annotation_role": {
      "$ref": "#/$defs/AnnotationRole"
    },
    "annotator_code": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[^\\x00-\\x1f\\x7f]{1,128}$",
      "title": "Annotator Code",
      "type": "string"
    },
    "evidence_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[^\\x00-\\x1f\\x7f]{1,128}$",
      "title": "Evidence Id",
      "type": "string"
    },
    "evidence_kind": {
      "enum": [
        "ranked",
        "sidecar"
      ],
      "title": "Evidence Kind",
      "type": "string"
    },
    "harmful_reason_code": {
      "anyOf": [
        {
          "enum": [
            "wrong_version",
            "wrong_regulated_object",
            "wrong_scope_condition_or_exception",
            "direct_conflict",
            "materially_misleading"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Harmful Reason Code"
    },
    "label": {
      "$ref": "#/$defs/EvidenceLabel"
    },
    "path_id": {
      "$ref": "#/$defs/PathId"
    },
    "question_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[^\\x00-\\x1f\\x7f]{1,128}$",
      "title": "Question Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "annotation_id",
    "question_id",
    "path_id",
    "evidence_id",
    "evidence_kind",
    "label",
    "annotation_role",
    "annotator_code",
    "annotated_at"
  ],
  "title": "EvidenceAnnotation",
  "type": "object"
}
