{
  "$defs": {
    "Domain": {
      "enum": [
        "chemical",
        "pharmaceutical"
      ],
      "title": "Domain",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assignment_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Assignment Hash",
      "type": "string"
    },
    "assignment_seed": {
      "default": 20260723,
      "title": "Assignment Seed",
      "type": "integer"
    },
    "domain": {
      "$ref": "#/$defs/Domain"
    },
    "fold": {
      "maximum": 4,
      "minimum": 0,
      "title": "Fold",
      "type": "integer"
    },
    "question_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Question Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_group_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Source Group Id",
      "type": "string"
    }
  },
  "required": [
    "question_id",
    "source_group_id",
    "domain",
    "fold",
    "assignment_hash"
  ],
  "title": "SplitAssignment",
  "type": "object"
}
